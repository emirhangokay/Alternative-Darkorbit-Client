{
  "name": "do-client",
  "version": "1.2.0",
  "description": "Alternative Darkorbit Client",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^23.0.3"
  },
  "build": {
    "appId": "com.do-client.app",
    "productName": "Alternative Darkorbit Client",
    "files": [
      "index.js",
      "preload.js",
      "tabs.html",
      "icon.ico",
      "ranks/*.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "extraResources": [
        "pepflashplayer.dll"
      ]
    },
    "nsis": {
      "artifactName": "Alternative Darkorbit Client Setup.${ext}",
      "uninstallDisplayName": "Uninstall"
    }
  }
}
