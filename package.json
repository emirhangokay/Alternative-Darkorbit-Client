{
  "name": "do-client",
  "version": "2.0.0",
  "description": "Alternative Darkorbit Client",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "ELIMINATOR",
  "license": "MIT",
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^23.0.3"
  },
  "build": {
    "appId": "com.do-client.app",
    "productName": "Alternative Darkorbit Client",
    "copyright": "Copyright © 2026 ELIMINATOR",
    "files": [
      "index.js",
      "preload.js",
      "tabs.html",
      "icon.ico",
      "ranks/*.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "extraResources": [
        "pepflashplayer.dll"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alternative Darkorbit Client",
      "runAfterFinish": true,
      "artifactName": "Alternative Darkorbit Client Setup ${version}.${ext}"
    }
  }
}
